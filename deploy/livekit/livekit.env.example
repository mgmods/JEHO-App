# Self-hosted LiveKit (open source) — free alternative to ZEGOCLOUD for voice.
# Keys below are ONLY used by LiveKit itself (generate strong random values).
# Your Nest API uses the same KEY/SECRET via LIVEKIT_API_KEY / LIVEKIT_API_SECRET.

LIVEKIT_KEYS: |
  APIJEHOVOICE: replace_with_32char_or_longer_secret_here

# LIVEKIT_HOST is public WSS endpoint (nginx + TLS via Cloudflare/origin).
LIVEKIT_HOST: voice.adastra.bbs.tr
