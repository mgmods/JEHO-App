<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/contentRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF4F6FA"
    android:layoutDirection="locale">

    <LinearLayout
        android:id="@+id/toolbarMedal"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="#FFFFFFFF"
        android:elevation="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/vBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/back"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="#FF263247" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/honourship"
            android:textColor="#FF182338"
            android:textSize="19sp"
            android:textStyle="bold" />

        <View
            android:layout_width="44dp"
            android:layout_height="44dp" />
    </LinearLayout>

    <View
        android:id="@+id/ivTopDecor"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/vModeTabBg"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_medal_tabs_track"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbarMedal" />

    <TextView
        android:id="@+id/tvBadgeTab"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:layout_margin="2dp"
        android:background="@drawable/bg_wallet_channel_on"
        android:gravity="center"
        android:text="@string/badge"
        android:textColor="#FF38280A"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/vModeTabBg"
        app:layout_constraintEnd_toStartOf="@id/tvMineTab"
        app:layout_constraintStart_toStartOf="@id/vModeTabBg"
        app:layout_constraintTop_toTopOf="@id/vModeTabBg" />

    <TextView
        android:id="@+id/tvMineTab"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:layout_margin="2dp"
        android:gravity="center"
        android:text="@string/mine"
        android:textColor="#FF536176"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/vModeTabBg"
        app:layout_constraintEnd_toEndOf="@id/vModeTabBg"
        app:layout_constraintStart_toEndOf="@id/tvBadgeTab"
        app:layout_constraintTop_toTopOf="@id/vModeTabBg" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMedals"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/vModeTabBg" />

    <LinearLayout
        android:id="@+id/llEmpty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/vModeTabBg"
        app:layout_constraintVertical_bias="0.35">

        <ImageView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:alpha="0.75"
            android:contentDescription="@null"
            android:src="@drawable/ic_medal_default" />

        <TextView
            android:id="@+id/tvEmptyMedal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/have_not_yet_received_badge"
            android:textColor="#FF536176"
            android:textSize="14sp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>