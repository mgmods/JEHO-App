<?xml version="1.0" encoding="utf-8"?>
<!-- Gift dial recipient cell: avatar + frame · seat chip · support under. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rl_gift_avatar_container"
    android:layout_width="58dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="2dp"
    android:paddingTop="2dp"
    android:paddingEnd="2dp"
    android:paddingBottom="2dp">

    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <com.Dramizo.Series.widget.CircleImageView
            android:id="@+id/civ_user_avatar"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_default_avatar" />

        <!-- Frame ABOVE avatar so cosmetics stay visible. -->
        <ImageView
            android:id="@+id/iv_avatar_frame"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <!-- Seat / host chip on top-end -->
        <TextView
            android:id="@+id/tv_seat_chip"
            android:layout_width="wrap_content"
            android:layout_height="14dp"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_gift_recipient_seat_chip"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minWidth="14dp"
            android:paddingHorizontal="3dp"
            android:textColor="#FFFFFFFF"
            android:textSize="8sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="3"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/iv_check_status"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="1dp"
            android:layout_marginBottom="1dp"
            android:background="@drawable/bg_gift_top_avatar_check"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="8sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Support under avatar: coin + amount -->
    <LinearLayout
        android:id="@+id/ll_support"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_asset_coin_gold" />

        <TextView
            android:id="@+id/tv_support_coins"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#E6FFD54F"
            android:textSize="9sp"
            android:textStyle="bold"
            tools:text="1.2K" />
    </LinearLayout>

    <!-- Selection underline under cell -->
    <View
        android:id="@+id/select_line"
        android:layout_width="22dp"
        android:layout_height="2.5dp"
        android:layout_marginTop="2dp"
        android:background="@drawable/bg_gift_seat_select_underline"
        android:visibility="invisible" />
</LinearLayout>
