<?xml version="1.0" encoding="utf-8"?>
<!-- Mikoo home toast: avatar | one line body | times badge (100 Times). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:background="@drawable/bg_celebration_toast"
    android:elevation="14dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp">

        <ImageView
            android:id="@+id/imgCelebrationAvatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_notification_avatar"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_tab_me" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvCelebrationBody"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:ellipsize="marquee"
        android:focusable="true"
        android:marqueeRepeatLimit="marquee_forever"
        android:maxLines="2"
        android:scrollHorizontally="true"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        tools:text="برو™ أرسل هدايا حظ للفوز بـ 200000 عملة. (100 مرة)" />

    <!-- Hidden title kept for binding compatibility -->
    <TextView
        android:id="@+id/tvCelebrationTitle"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/imgCelebrationBadge"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="4dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:visibility="gone"
        tools:visibility="gone" />

    <FrameLayout
        android:id="@+id/wrapCelebrationTimes"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_celebration_times_badge"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tvCelebrationTimes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:lineSpacingExtra="-2dp"
            android:padding="4dp"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="100\nTimes" />
    </FrameLayout>

    <!-- Mikoo planet / detonate “Go” chip -->
    <TextView
        android:id="@+id/btnCelebrationGo"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:background="@drawable/bg_planet_go_btn"
        android:gravity="center"
        android:minWidth="52dp"
        android:paddingHorizontal="14dp"
        android:text="Go"
        android:textColor="#FF4A148C"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:visibility="visible" />
</LinearLayout>
