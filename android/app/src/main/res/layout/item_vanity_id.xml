<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="3dp"
    android:background="@drawable/bg_vanity_store_card"
    android:orientation="vertical"
    android:padding="6dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@drawable/bg_vanity_store_hero"
        android:padding="4dp">

        <TextView
            android:id="@+id/tvPublicId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="0.02"
            android:maxLines="1"
            android:text="000000"
            android:textColor="#FFFFFFFF"
            android:textSize="21sp"
            android:textStyle="bold"
            app:autoSizeMaxTextSize="21sp"
            app:autoSizeMinTextSize="9sp"
            app:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvTier"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_mall_balance_pill"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingHorizontal="3dp"
        android:paddingVertical="3dp"
        android:text="@string/vanity_tier_special"
        android:textColor="#FF6844C5"
        android:textSize="9sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvMineBadge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:background="@drawable/bg_vanity_chip_gold"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingHorizontal="3dp"
        android:paddingVertical="2dp"
        android:text="@string/vanity_mine_badge"
        android:textColor="#9A6700"
        android:textSize="9sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:maxLines="2"
        android:minLines="2"
        android:ellipsize="end"
        android:textColor="@color/text_primary"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/text_secondary"
        android:textSize="9sp" />

    <TextView
        android:id="@+id/btnBuy"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="7dp"
        android:foreground="@drawable/bg_store_button_ripple"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_cosmetic_btn_buy"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingHorizontal="2dp"
        android:text="@string/vanity_buy"
        android:textAllCaps="false"
        android:textColor="#FFFFFFFF"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
