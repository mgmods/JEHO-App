<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/exo_preview_card"
        android:layout_width="130dp"
        android:layout_height="wrap_content"
        android:layout_above="@id/exo_progress"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="128dp"
        android:background="@drawable/time_popup_background"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/exo_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.media3.ui.DefaultTimeBar
        android:id="@+id/exo_progress"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="40dp"
        android:clickable="true"
        android:focusable="true"
        app:bar_height="4dp"
        app:buffered_color="@color/text_hint"
        app:played_color="#E50914"
        app:scrubber_color="#E50914"
        app:scrubber_disabled_size="0dp"
        app:scrubber_dragged_size="20dp"
        app:scrubber_enabled_size="13dp"
        app:touch_target_height="44dp"
        app:unplayed_color="#4DFFFFFF" />
</RelativeLayout>
