<?xml version="1.0" encoding="utf-8"?>
<!-- Vertical dropdown — Mikoo RoomGiftDialog: 1 / 7 / 17 / 77 / 177 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_mikoo_gift_qty_popup"
    android:elevation="12dp"
    android:minWidth="88dp"
    android:orientation="vertical"
    android:paddingVertical="4dp">

    <TextView
        android:id="@+id/popupQty1"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:text="1"
        android:textColor="@color/mikoo_gift_text"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/popupQty7"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:text="7"
        android:textColor="@color/mikoo_gift_text"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/popupQty17"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:text="17"
        android:textColor="@color/mikoo_gift_text"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/popupQty27"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:text="77"
        android:textColor="@color/mikoo_gift_text"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/popupQty77"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:text="177"
        android:textColor="@color/mikoo_gift_text"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
