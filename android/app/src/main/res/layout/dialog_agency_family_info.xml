<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/clAgencyFamilyRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingBottom="20dp">

    <View
        android:id="@+id/agencyFamilyBg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_agency_family_sheet"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/agencyHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/imgAgencyLogo"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/icon_agency" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAgencyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/agency_family_info_title"
                android:textColor="#99FFFFFF"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvAgencyName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="start"
                android:maxLines="2"
                android:textColor="#FFFFFFFF"
                android:textSize="21sp"
                android:textStyle="bold"
                tools:text="وكالة النجوم" />

            <LinearLayout
                android:id="@+id/rowAgencyId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvAgencyGid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#B3FFFFFF"
                    android:textSize="13sp"
                    tools:text="ID: 1895" />

                <ImageView
                    android:id="@+id/btnCopyAgencyId"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@string/copy_user_id"
                    android:src="@drawable/icon_copy"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp">

            <ImageView
                android:id="@+id/imgAgencyBanner"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/icon_info_guild_bg_base_lv1" />

            <TextView
                android:id="@+id/tvMedals"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="1"
                android:textColor="#FFFFD56A"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="L1" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/btnFollowAgency"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginHorizontal="22dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_agency_follow_btn"
        android:gravity="center"
        android:text="@string/agency_family_follow"
        android:textColor="#FF0B1A16"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/agencyHeader" />

    <TextView
        android:id="@+id/btnOpenAgencyManage"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnFollowAgency" />

    <TextView
        android:id="@+id/tvFollowers"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvRooms"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvMaxOnline"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvGifts"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/imgOwnerAvatar"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvOwnerName"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <View
        android:id="@+id/rowAgencyStats"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <View
        android:id="@+id/rowOwner"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />
</androidx.constraintlayout.widget.ConstraintLayout>
