<?xml version="1.0" encoding="utf-8"?>
<!-- Shared bubble body (included by mine + peer row layouts). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bubbleRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_chat_bubble_peer"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/tvVipChip"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/rowBadges"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone">
        <TextView android:id="@+id/tvWealthChip" android:layout_width="0dp" android:layout_height="0dp" />
        <TextView android:id="@+id/tvCharmChip" android:layout_width="0dp" android:layout_height="0dp" />
        <TextView android:id="@+id/tvLevelChip" android:layout_width="0dp" android:layout_height="0dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvMeta"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvSender"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:maxWidth="240dp"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="أحمد" />

    <LinearLayout
        android:id="@+id/replyQuote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_chat_reply_quote"
        android:orientation="vertical"
        android:paddingHorizontal="8dp"
        android:paddingVertical="5dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvReplyAuthor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="230dp"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvReplyBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:maxWidth="230dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/imgMedia"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/audioRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minWidth="120dp"
        android:minHeight="36dp"
        android:orientation="horizontal"
        android:paddingHorizontal="2dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvAudioDur"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="22dp"
            android:textColor="#FF333333"
            android:textSize="13sp"
            tools:text="3&quot;" />

        <com.Dramizo.Series.presentation.chat.AudioWaveformView
            android:id="@+id/waveAudio"
            android:layout_width="80dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp" />

        <FrameLayout
            android:id="@+id/audioPlayWrap"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:background="@android:color/transparent">

            <ImageView
                android:id="@+id/imgAudioPlay"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@string/voice_message"
                android:src="@drawable/ic_audio_play"
                app:tint="#FF4A90E2" />
        </FrameLayout>

        <SeekBar
            android:id="@+id/seekAudio"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Agency family invite card -->
    <LinearLayout
        android:id="@+id/agencyInviteRow"
        android:layout_width="248dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_agency_invite_card"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgAgencyInviteLogo"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_room_share_cover_clip"
                android:clipToOutline="true"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/icon_agency" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAgencyInviteName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FF1F2430"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="وكالة التاج" />

                <TextView
                    android:id="@+id/tvAgencyInviteBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="1dp"
                    android:text="@string/agency_invite_body"
                    android:textColor="#FF5C667A"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnAgencyInviteNo"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_agency_invite_no"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/agency_invite_disagree"
                android:textColor="#FF43D3A2"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnAgencyInviteYes"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_agency_invite_yes"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/agency_invite_agree"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/giftRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="2dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/imgGift"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_asset_gift" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gift_message"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvGiftLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/aurora_gold"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Room share card (same spacing spirit as family invite) -->
    <LinearLayout
        android:id="@+id/roomShareRow"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_wallet_section"
        android:foreground="?attr/selectableItemBackground"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/imgRoomShareCover"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:background="@drawable/bg_room_share_cover_clip"
            android:clipToOutline="true"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@color/white" />

        <TextView
            android:id="@+id/tvRoomShareTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="غرفة صوتية" />

        <TextView
            android:id="@+id/tvRoomShareCta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_wallet_channel_on"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:text="دخول الغرفة"
            android:textColor="#1A1200"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:gravity="start"
        android:maxWidth="240dp"
        android:textColor="#FF222222"
        android:textDirection="locale"
        android:textSize="15sp"
        android:lineSpacingExtra="2dp"
        tools:text="مرحبا، كيف حالك؟" />

    <TextView
        android:id="@+id/tvTranslateAction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:paddingVertical="2dp"
        android:text="@string/translate"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:visibility="gone"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tvTranslated"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxWidth="220dp"
        android:textColor="@color/text_secondary"
        android:textDirection="locale"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="Hello, how are you?"
        tools:visibility="visible" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginStart="16dp"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#99000000"
            android:textSize="10sp"
            tools:text="10:42" />

        <ImageView
            android:id="@+id/imgMsgStatus"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@null"
            android:visibility="gone"
            tools:src="@drawable/ic_msg_sent"
            tools:visibility="visible" />
    </LinearLayout>
</LinearLayout>
