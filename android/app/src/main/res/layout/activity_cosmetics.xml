<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/imgThemeBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:background="#F5F6FB"
        android:src="@null" />

    <LinearLayout
        android:id="@+id/contentRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="#F5F6FB"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/back"
                android:padding="10dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/text_primary" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="@string/appearance_store"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:letterSpacing="-0.02"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnBag"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_mall_action_primary"
                android:elevation="3dp"
                android:gravity="center"
                android:minWidth="96dp"
                android:paddingHorizontal="13dp"
                android:text="👜  حقيبتي"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnRecharge"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_mall_action_primary"
                android:gravity="center"
                android:minWidth="76dp"
                android:paddingHorizontal="12dp"
                android:text="@string/mall_recharge"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/storeBalanceStrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="14dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="6dp"
            android:minHeight="54dp"
            android:background="@drawable/bg_mall_wallet_card"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <TextView
                android:id="@+id/tvStoreBalanceLabel"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:gravity="center_vertical"
                android:text="رصيدك"
                android:textColor="#FF656B7B"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvStoreBalance"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_mall_balance_pill"
                android:drawableStart="@drawable/icon_coin"
                android:drawablePadding="5dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="—"
                android:textColor="#FF5B35B5"
                android:textSize="14sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvStoreTagline"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:gravity="center_vertical"
                android:text="اكتشف إطلالتك الجديدة  ✦"
                android:textColor="#FF656B7B"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Persistent current-user identity: avatar/frame, name, and live special-ID styling. -->
        <LinearLayout
            android:id="@+id/storeUserHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="14dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_mall_native_hero"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">

            <com.Dramizo.Series.util.HostSignalView
                android:id="@+id/storeUserFrame"
                android:layout_width="76dp"
                android:layout_height="76dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStoreUserName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="اسم المستخدم" />

                <TextView
                    android:id="@+id/tvStoreUserPublicId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="start|center_vertical"
                    android:letterSpacing="0.08"
                    android:maxLines="1"
                    android:text="123456"
                    android:textColor="#FFFFFFFF"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="الآيدي المميز"
                    android:textColor="#DFFFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/btnSpecialIdsShortcut"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginHorizontal="14dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_mall_action_outline"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="✦  الآيدي المميز — تصفح الأرقام النادرة"
            android:textColor="#FF5B35B5"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Native hero: HostSignalView (SVGA) for frames — same engine as live room. -->
        <LinearLayout
            android:id="@+id/nativeHeroWrap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="14dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="2dp"
            android:background="@drawable/bg_mall_native_hero"
            android:elevation="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <FrameLayout
                android:layout_width="116dp"
                android:layout_height="116dp">

                <com.Dramizo.Series.util.HostSignalView
                    android:id="@+id/nativeHeroFrame"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center" />

                <ImageView
                    android:id="@+id/heroMedia"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvHeroName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="#FFFFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    tools:text="إطار ذهبي" />

                <TextView
                    android:id="@+id/tvHeroHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/mall_preview_hint"
                    android:textColor="#E8FFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvHeroDays"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_mall_hero_chip"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="متبقي 12 يوم"
                    tools:visibility="visible" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabs"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginHorizontal="14dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="2dp"
            android:background="@drawable/bg_mall_tabs"
            android:elevation="2dp"
            android:paddingHorizontal="6dp"
            app:tabGravity="center"
            app:tabIndicatorColor="#FF7755D9"
            app:tabIndicatorHeight="3dp"
            app:tabRippleColor="#227755D9"
            app:tabIndicatorFullWidth="false"
            app:tabMode="scrollable"
            app:tabSelectedTextColor="#FF5B35B5"
            app:tabTextColor="#FF7D8293" />

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
</FrameLayout>
