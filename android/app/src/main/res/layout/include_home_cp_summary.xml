<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/homeCpSummary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="10dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_home_cp_summary"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="عالم CP · الارتباط والمكافآت"
            android:textColor="#8D245A"
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/cpHomeRequests"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_offers_badge"
            android:paddingHorizontal="9dp"
            android:paddingVertical="5dp"
            android:text="الطلبات —"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/cpHomeStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:text="جارٍ تحميل بيانات CP…"
        android:textColor="#6C5261"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/cpHomeActive"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">
        <ImageView
            android:id="@+id/cpHomePartnerAvatar"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_seat_avatar_clip"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_tab_me" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/cpHomePartnerName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="مرتبط بـ —"
                android:textColor="#54203D"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/cpHomeLevel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="المستوى —"
                android:textColor="#9B3B70"
                android:textSize="12sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/cpHomePoints"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 نقطة"
            android:textColor="#9B3B70"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/cpHomeProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="7dp"
        android:layout_marginTop="9dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#E84D91"
        android:visibility="gone" />

    <TextView
        android:id="@+id/cpHomeStats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:textColor="#765365"
        android:textSize="11sp"
        android:visibility="gone" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:text="مكافآت المستويات"
        android:textColor="#8D245A"
        android:textSize="13sp"
        android:textStyle="bold" />
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:scrollbars="none">
        <LinearLayout
            android:id="@+id/cpHomeRewards"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:text="المتصدرون هذا الأسبوع"
        android:textColor="#8D245A"
        android:textSize="13sp"
        android:textStyle="bold" />
    <LinearLayout
        android:id="@+id/cpHomeLeaderboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:orientation="vertical" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/cpHomeEndButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/bg_room_tool_circle"
            android:gravity="center"
            android:text="إلغاء الارتباط"
            android:textColor="#9B244F"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
        <TextView
            android:id="@+id/cpHomeMoreButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_offers_badge"
            android:gravity="center"
            android:text="إدارة CP والطلبات"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
