<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardBackgroundColor="#FFF8F5EF"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="#1A000000"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="10dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:background="@drawable/bg_cosmetic_preview"
            android:clipChildren="true"
            android:clipToPadding="true">

            <ImageView
                android:id="@+id/imgPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:padding="8dp"
                android:scaleType="fitCenter" />

            <com.Dramizo.Series.util.HostSignalView
                android:id="@+id/webHostPreview"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:minLines="2"
            android:textColor="#FF1A1F2E"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="إطار ذهبي" />

        <TextView
            android:id="@+id/tvPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_cosmetic_price_chip"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:textColor="#FF8A4B08"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="500 عملة" />

        <!-- Single action button: شراء / تجهيز / مجهّز — avoids black invisible secondary btn -->
        <TextView
            android:id="@+id/btnPurchase"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_cosmetic_btn_buy"
            android:gravity="center"
            android:text="@string/purchase"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnEquip"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_cosmetic_btn_equip"
            android:gravity="center"
            android:text="@string/equip"
            android:textColor="#FF0F766E"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
