<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="3dp"
    app:cardBackgroundColor="#FFFFFFFF"
    app:cardCornerRadius="18dp"
    app:cardElevation="1dp"
    app:strokeColor="#FFE8E1F7"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="7dp">

        <!-- Lightweight preview: NO HostSignalView / SVGA in mall grid (OOM crash). -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:background="@drawable/bg_cosmetic_preview"
            android:clipChildren="true"
            android:clipToPadding="true">

            <ImageView
                android:id="@+id/imgFace"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/imgPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:padding="6dp"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/tvVipLock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="6dp"
                android:background="@drawable/bg_mall_balance_pill"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textColor="#FF5B35B5"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="VIP 7"
                tools:visibility="visible" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:minLines="2"
            android:textColor="#FF1A1F2E"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="إطار ذهبي" />

        <TextView
            android:id="@+id/tvPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:background="@drawable/bg_mall_balance_pill"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="6dp"
            android:paddingVertical="3dp"
            android:textColor="#FF5B35B5"
            android:textSize="10sp"
            android:textStyle="bold"
            tools:text="500 عملة" />

        <TextView
            android:id="@+id/btnPurchase"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="7dp"
            android:foreground="@drawable/bg_store_button_ripple"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_cosmetic_btn_buy"
            android:gravity="center"
            android:text="@string/purchase"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnEquip"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:foreground="@drawable/bg_store_button_ripple"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_cosmetic_btn_equip"
            android:gravity="center"
            android:text="@string/equip"
            android:textColor="#FF0F766E"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
