<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/imgThemeBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@color/white" />

<LinearLayout android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/back"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/privacy"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_list_card"
        android:orientation="vertical"
        android:paddingVertical="6dp">

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchOnline"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingHorizontal="14dp"
            android:text="إظهار حالة الاتصال"
            android:textColor="@color/text_primary" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchDm"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingHorizontal="14dp"
            android:text="السماح برسائل الغرباء"
            android:textColor="@color/text_primary" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchDmGiftGate"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingHorizontal="14dp"
            android:text="طلب هدية قبل أول رسالة"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/tvDmGiftHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="14dp"
            android:paddingBottom="8dp"
            android:text="عند التفعيل يجب على المرسل إرسال هدية قبل أول رسالة نصية"
            android:textColor="@color/text_hint"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnPickDmGift"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:text="اختيار الهدية المطلوبة (اختياري)"
            android:textColor="@color/aurora_teal"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
</FrameLayout>
