<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_aura_dialog_surface"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_sheet_handle" />

    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="@string/settings"
        android:textColor="@color/text_primary"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:text="إعدادات الغرفة والمقاعد"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/btnSeatRequests"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_room_dialog_item"
        android:gravity="center"
        android:text="طلبات الانضمام للمايك"
        android:textColor="@color/aurora_gold"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="عدد المقاعد"
        android:textColor="@color/aurora_teal"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/rowSeatCounts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnSeats10"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_room_dialog_item"
            android:gravity="center"
            android:text="10"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSeats15"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_room_dialog_item"
            android:gravity="center"
            android:text="15"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSeats20"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_room_dialog_item"
            android:gravity="center"
            android:text="20"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnToggleLock"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_room_dialog_item"
        android:drawablePadding="10dp"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:drawableStart="@drawable/more_btn_lock_kai"
        android:text="@string/lock_room"
        android:textColor="@color/aurora_gold"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/rowGiftSounds"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_room_dialog_item"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/room_gift_sounds"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchGiftSounds"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@color/switch_thumb_room"
            app:trackTint="@color/switch_track_room" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvGiftSoundsHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:paddingHorizontal="4dp"
        android:text="يعمل فوراً لكل من في الغرفة — أخضر = مفعّل"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="خلفيات الغرفة"
        android:textColor="@color/aurora_teal"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnPickRoomBackground"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_room_dialog_item"
        android:drawablePadding="10dp"
        android:drawableStart="@drawable/more_btn_theme"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:gravity="center_vertical"
        android:text="اختيار خلفية الروم"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnManageSeats"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_room_dialog_item"
        android:drawablePadding="10dp"
        android:drawableStart="@drawable/more_btn_lock"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:gravity="center_vertical"
        android:text="قفل / فتح المقاعد"
        android:textColor="@color/aurora_gold"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnManageMods"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_room_dialog_item"
        android:drawablePadding="10dp"
        android:drawableStart="@drawable/icon_room_opera_admin"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:gravity="center_vertical"
        android:text="إدارة المشرفين"
        android:textColor="@color/aurora_cyan"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/btnDialogClose"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_room_dialog_item"
        android:gravity="center"
        android:text="@string/cancel_game"
        android:textColor="@color/text_primary"
        android:textStyle="bold" />
</LinearLayout>
