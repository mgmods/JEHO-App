<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <ImageView
        android:id="@+id/imgHomeBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/home_page_bg" />

    <LinearLayout
        android:id="@+id/contentRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- JEHO home header: fixed visual identity, server-configurable actions. -->
        <LinearLayout
            android:id="@+id/homeHeader"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">

            <FrameLayout
                android:id="@+id/btnFilter"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_icon_circle_light"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/imgFilterIcon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/voice_room"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvHomeBrand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="JEHO"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_icon_circle_light"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/btnSearch"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/search"
                    android:scaleType="fitCenter" />
            </FrameLayout>
        </LinearLayout>

        <!-- Legacy home tabs kept as non-visible binding compatibility. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone">

            <LinearLayout android:id="@+id/tabMeWrap" android:layout_width="0dp" android:layout_height="0dp">
                <TextView android:id="@+id/tvTabMe" android:layout_width="0dp" android:layout_height="0dp" />
                <View android:id="@+id/dotMe" android:layout_width="0dp" android:layout_height="0dp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/tabHotWrap" android:layout_width="0dp" android:layout_height="0dp">
                <TextView android:id="@+id/tvTabHot" android:layout_width="0dp" android:layout_height="0dp" />
                <View android:id="@+id/dotHot" android:layout_width="0dp" android:layout_height="0dp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/tabLocationWrap" android:layout_width="0dp" android:layout_height="0dp">
                <TextView android:id="@+id/tvTabLocation" android:layout_width="0dp" android:layout_height="0dp" />
                <ImageView android:id="@+id/imgTabLocationFlag" android:layout_width="0dp" android:layout_height="0dp" />
                <View android:id="@+id/dotLocation" android:layout_width="0dp" android:layout_height="0dp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/tabActivitiesWrap" android:layout_width="0dp" android:layout_height="0dp">
                <TextView android:id="@+id/tvTabActivities" android:layout_width="0dp" android:layout_height="0dp" />
                <View android:id="@+id/dotActivities" android:layout_width="0dp" android:layout_height="0dp" />
            </LinearLayout>
        </LinearLayout>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Mikoo-style: AppBar headers collapse; RV recycles pages of rooms -->
            <androidx.coordinatorlayout.widget.CoordinatorLayout
                android:id="@+id/homeScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

            <com.google.android.material.appbar.AppBarLayout
                android:id="@+id/homeAppBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                app:elevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_scrollFlags="scroll|snap">

                <!-- Mikoo-style auto-sliding banner (server images, max 3) -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="15dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="8dp">

                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/pagerBanners"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:overScrollMode="never" />

                    <LinearLayout
                        android:id="@+id/bannerDots"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="8dp"
                        android:gravity="center"
                        android:orientation="horizontal" />
                </FrameLayout>

                <!-- غرفتي تنتقل لتبويب «أنا» (HomeMeFragment) -->
                <include
                    android:id="@+id/myRoomCardHome"
                    layout="@layout/include_my_room_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <include
                    android:id="@+id/homeActBanners"
                    layout="@layout/include_home_act_banners"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <!-- Mikoo Hot = one RV only (no separate top-4 explore grid). -->
                <include
                    android:id="@+id/homeExplore"
                    layout="@layout/include_home_explore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <!-- Binding stubs for older 3-slot row (kept for ID compatibility) -->
                <LinearLayout
                    android:id="@+id/bannerRow"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgBanner1"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:src="@drawable/home_bg_wealth" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgBanner2"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:src="@drawable/home_bg_cp" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgBanner3"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:src="@drawable/home_bg_charm" />
                </LinearLayout>

                <!-- Duplicate tiles removed — CP/charm/tasks live in homeActBanners -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginHorizontal="16dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <FrameLayout
                        android:id="@+id/tileActivity"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/imgTileActivity"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:src="@drawable/ic_asset_tasks" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/tileRich"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/imgTileRich"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:src="@drawable/ic_feat_ranking" />

                        <ImageView
                            android:id="@+id/imgRichAvatar1"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:src="@drawable/ic_tab_me" />
                        <ImageView
                            android:id="@+id/imgRichFrame1"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:visibility="gone" />
                        <ImageView
                            android:id="@+id/imgRichAvatar2"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:src="@drawable/ic_tab_me" />
                        <ImageView
                            android:id="@+id/imgRichFrame2"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:visibility="gone" />
                        <ImageView
                            android:id="@+id/imgRichAvatar3"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:src="@drawable/ic_tab_me" />
                        <ImageView
                            android:id="@+id/imgRichFrame3"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:visibility="gone" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/tileBillion"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/imgTileBillion"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:src="@drawable/ic_asset_gift" />
                        <ImageView
                            android:id="@+id/imgBillionAvatar1"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:src="@drawable/ic_tab_me" />
                        <ImageView
                            android:id="@+id/imgBillionFrame1"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:visibility="gone" />
                        <ImageView
                            android:id="@+id/imgBillionAvatar2"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:src="@drawable/ic_tab_me" />
                        <ImageView
                            android:id="@+id/imgBillionFrame2"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:visibility="gone" />
                        <ImageView
                            android:id="@+id/imgBillionAvatar3"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:src="@drawable/ic_tab_me" />
                        <ImageView
                            android:id="@+id/imgBillionFrame3"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:visibility="gone" />
                    </FrameLayout>
                </LinearLayout>

            </LinearLayout>
            </com.google.android.material.appbar.AppBarLayout>

                <!-- Rooms feed: normal RecyclerView recycling under AppBar -->
                <FrameLayout
                    android:id="@+id/feedHost"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="4dp"
                    app:layout_behavior="@string/appbar_scrolling_view_behavior">

                    <com.Dramizo.Series.presentation.common.NestedScrollableHost
                        android:id="@+id/feedScrollHost"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <androidx.viewpager2.widget.ViewPager2
                            android:id="@+id/pagerFeed"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:overScrollMode="never" />
                    </com.Dramizo.Series.presentation.common.NestedScrollableHost>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recycler"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/emptyRoomsWrap"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:minHeight="280dp"
                        android:orientation="vertical"
                        android:paddingHorizontal="24dp"
                        android:paddingVertical="32dp"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/imgEmptyRooms"
                            android:layout_width="168dp"
                            android:layout_height="168dp"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_default_blank" />

                        <TextView
                            android:id="@+id/tvEmptyRooms"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center"
                            android:text="@string/home_no_rooms"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>
                </FrameLayout>
            </androidx.coordinatorlayout.widget.CoordinatorLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/btnOffersGift"
        android:layout_width="88dp"
        android:layout_height="96dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="84dp"
        android:contentDescription="@string/store_offers_title"
        android:elevation="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/btnOffersClose"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="top|start"
            android:background="@drawable/bg_room_tool_circle"
            android:contentDescription="@string/close"
            android:elevation="4dp"
            android:gravity="center"
            android:text="×"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottieOffersBurst"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="top|center_horizontal"
            android:visibility="invisible"
            app:lottie_autoPlay="false"
            app:lottie_loop="false"
            app:lottie_rawRes="@raw/lottie_gift_burst" />

        <ImageView
            android:id="@+id/imgOffersGiftBox"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="5dp"
            android:contentDescription="@null"
            android:padding="3dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_asset_chest_gold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_gravity="bottom"
            android:gravity="center"
            android:text="@string/store_offers_title"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvOffersBadge"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/bg_offers_badge"
            android:gravity="center"
            android:text="0"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>
</FrameLayout>
