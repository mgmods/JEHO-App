<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="bottom"
    android:layoutDirection="ltr"
    android:orientation="horizontal"
    android:paddingHorizontal="6dp"
    android:paddingVertical="6dp">

    <!-- Order swapped in code: peer = avatar|bubble , mine = bubble|avatar -->
    <FrameLayout
        android:id="@+id/avatarWrap"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginBottom="2dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <ImageView
            android:id="@+id/imgAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_tab_me" />

        <ImageView
            android:id="@+id/imgFrame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/imgHostBadge"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/bubbleColumn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="6dp"
        android:maxWidth="280dp"
        android:orientation="vertical">

        <!-- Name lives inside bubbleRoot (tvSender). -->

        <TextView
            android:id="@+id/tvVipChip"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/rowBadges"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone">
            <TextView android:id="@+id/tvWealthChip" android:layout_width="0dp" android:layout_height="0dp" />
            <TextView android:id="@+id/tvCharmChip" android:layout_width="0dp" android:layout_height="0dp" />
            <TextView android:id="@+id/tvLevelChip" android:layout_width="0dp" android:layout_height="0dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvMeta"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/bubbleRoot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chat_bubble_peer"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingTop="7dp"
            android:paddingBottom="5dp">

            <!-- Display name (same as chat header) above the message. -->
            <TextView
                android:id="@+id/tvSender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:maxWidth="200dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="أحمد" />

            <LinearLayout
                android:id="@+id/replyQuote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_chat_reply_quote"
                android:orientation="vertical"
                android:paddingHorizontal="8dp"
                android:paddingVertical="5dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvReplyAuthor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="250dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvReplyBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:maxWidth="250dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/imgMedia"
                android:layout_width="168dp"
                android:layout_height="168dp"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/audioRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minWidth="132dp"
                android:orientation="horizontal"
                android:paddingVertical="0dp"
                android:visibility="gone">

                <FrameLayout
                    android:id="@+id/audioPlayWrap"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_chat_audio_play">

                    <ImageView
                        android:id="@+id/imgAudioPlay"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/voice_message"
                        android:src="@drawable/ic_audio_play"
                        app:tint="@color/text_primary" />
                </FrameLayout>

                <com.Dramizo.Series.presentation.chat.AudioWaveformView
                    android:id="@+id/waveAudio"
                    android:layout_width="88dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="8dp" />

                <SeekBar
                    android:id="@+id/seekAudio"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvAudioDur"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:minWidth="28dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="0:12" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/giftRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="2dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/imgGift"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_asset_gift" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/gift_message"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvGiftLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/aurora_gold"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/roomShareRow"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_wallet_section"
                android:foreground="?attr/selectableItemBackground"
                android:orientation="vertical"
                android:padding="8dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/imgRoomShareCover"
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:background="@drawable/bg_room_share_cover_clip"
                    android:clipToOutline="true"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@color/white" />

                <TextView
                    android:id="@+id/tvRoomShareTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="غرفة صوتية" />

                <TextView
                    android:id="@+id/tvRoomShareCta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_wallet_channel_on"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    android:text="دخول الغرفة"
                    android:textColor="#1A1200"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvContent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:gravity="start"
                android:maxWidth="200dp"
                android:textColor="@color/text_primary"
                android:textDirection="locale"
                android:textSize="13sp"
                tools:text="مرحبا، كيف حالك؟" />

            <TextView
                android:id="@+id/tvTranslateAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingVertical="2dp"
                android:text="@string/translate"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvTranslated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxWidth="200dp"
                android:textColor="@color/text_secondary"
                android:textDirection="locale"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="Hello, how are you?"
                tools:visibility="visible" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginStart="20dp"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_hint"
                    android:textSize="10sp"
                    tools:text="10:42" />

                <ImageView
                    android:id="@+id/imgMsgStatus"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="4dp"
                    android:contentDescription="@null"
                    android:visibility="gone"
                    tools:src="@drawable/ic_msg_sent"
                    tools:visibility="visible" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
