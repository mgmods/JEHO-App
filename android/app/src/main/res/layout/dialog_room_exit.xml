<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Tap outside actions to cancel -->
    <View
        android:id="@+id/btnCancelExit"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:contentDescription="@string/close" />

    <LinearLayout
        android:id="@+id/exitActionsPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="28dp">

        <TextView
            android:id="@+id/tvExitHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="22dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="غرفة الوكالة دائمة وستبقى متاحة بعد مغادرتك"
            android:textColor="#F2FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Keep · Leave (always visible, side by side) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/btnMinimize"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:background="@drawable/bg_exit_action_circle"
                    android:clickable="true"
                    android:contentDescription="احتفظ"
                    android:elevation="12dp"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_room_keep" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="احتفظ"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/btnLeave"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:background="@drawable/bg_exit_action_circle"
                    android:clickable="true"
                    android:contentDescription="خروج"
                    android:elevation="12dp"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_room_leave" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="خروج"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Host-only: End live (always in view, not buried) -->
        <LinearLayout
            android:id="@+id/rowEndBroadcast"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/btnEndBroadcast"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:background="@drawable/bg_exit_end_live_circle"
                android:clickable="true"
                android:contentDescription="إنهاء البث"
                android:elevation="14dp"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_room_end_broadcast" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvEndBroadcastLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="إنهاء البث"
                android:textColor="#FF8A9B"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Host-only: Summon -->
        <LinearLayout
            android:id="@+id/rowSummon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/btnSummon"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_exit_action_circle"
                android:clickable="true"
                android:contentDescription="استدعاء"
                android:elevation="10dp"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_room_bell"
                    android:tint="#0B1220" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvSummonLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="استدعاء"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
