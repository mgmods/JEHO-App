<?xml version="1.0" encoding="utf-8"?>
<!-- Setting row with optional trailing value (language name, etc.). -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="58dp"
    android:background="@drawable/bg_settings_row"
    android:foreground="?attr/selectableItemBackground">

    <TextView
        android:id="@+id/tvSettingTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="20dp"
        android:textColor="#FF202B3A"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/imgSettingArrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="16dp"
        android:text="›"
        android:textColor="#FF8D99A8"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/tvSettingValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toStartOf="@id/imgSettingArrow"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingEnd="8dp"
        android:textColor="#FF999999"
        android:textSize="13sp" />
</RelativeLayout>
