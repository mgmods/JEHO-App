<?xml version="1.0" encoding="utf-8"?>
<!-- JEHO light music library — أنا / شعبية / بحث بالإنترنت -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_grouped_bg"
    android:layoutDirection="locale">

    <LinearLayout
        android:id="@+id/ll_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_surface"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/iv_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_music_nav_back"
            app:tint="@color/text_primary" />

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingVertical="4dp">

                <LinearLayout
                    android:id="@+id/tabMineWrap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="10dp">

                    <TextView
                        android:id="@+id/tvMusicTabMine"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingVertical="8dp"
                        android:text="@string/music_tab_mine"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <View
                        android:id="@+id/indMine"
                        android:layout_width="22dp"
                        android:layout_height="3dp"
                        android:background="@drawable/bg_music_tab_indicator" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tabHotWrap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="10dp">

                    <TextView
                        android:id="@+id/tvMusicTabHot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingVertical="8dp"
                        android:text="@string/music_tab_hot"
                        android:textColor="@color/text_hint"
                        android:textSize="15sp" />

                    <View
                        android:id="@+id/indHot"
                        android:layout_width="22dp"
                        android:layout_height="3dp"
                        android:background="@drawable/bg_music_tab_indicator"
                        android:visibility="invisible" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tabInternetWrap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="10dp">

                    <TextView
                        android:id="@+id/tvMusicTabInternet"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingVertical="8dp"
                        android:text="@string/music_tab_internet"
                        android:textColor="@color/text_hint"
                        android:textSize="15sp" />

                    <View
                        android:id="@+id/indInternet"
                        android:layout_width="22dp"
                        android:layout_height="3dp"
                        android:background="@drawable/bg_music_tab_indicator"
                        android:visibility="invisible" />
                </LinearLayout>
            </LinearLayout>
        </HorizontalScrollView>

        <FrameLayout
            android:id="@+id/fl_menu"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@mipmap/icon_music_library_menu_local"
                app:tint="@color/text_primary" />
        </FrameLayout>
    </LinearLayout>

    <include layout="@layout/view_music_play_control" />

    <FrameLayout
        android:id="@+id/vp_musicList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/rl_musicPlayControl"
        android:layout_below="@id/ll_nav">

        <include
            android:id="@+id/pageMine"
            layout="@layout/fragment_my_music_library"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            android:id="@+id/pageHot"
            layout="@layout/fragment_server_music_library"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <include
            android:id="@+id/pageInternet"
            layout="@layout/fragment_internet_music_library"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/ll_menu"
        android:layout_width="168dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/ll_nav"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_music_library_menu_light"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/ll_localMusic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@mipmap/icon_music_library_menu_local"
                app:tint="@color/text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/music_library_menu_local"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
