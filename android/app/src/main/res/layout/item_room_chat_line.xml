<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="3dp"
    android:paddingEnd="40dp"
    android:paddingBottom="3dp">

    <!-- Mikoo public-screen compact bubble (#4D000000 / 8dp) -->
    <LinearLayout
        android:id="@+id/chatBubbleRoot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_room_chat_bubble"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="top"
        android:maxWidth="340dp"
        android:minWidth="168dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <FrameLayout
            android:id="@+id/chatAvatarWrap"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="0dp"
            android:layout_marginEnd="8dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ImageView
                android:id="@+id/imgChatAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_tab_me" />

            <ImageView
                android:id="@+id/imgChatFrame"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:elevation="2dp"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <com.Dramizo.Series.util.HostSignalView
                android:id="@+id/webChatHostSignal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:elevation="3dp"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvHostChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_seat_host_chip"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="1dp"
                    android:text="المبدع"
                    android:textColor="@color/aurora_gold"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tvChatName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:ellipsize="end"
                    android:focusable="true"
                    android:maxLines="1"
                    android:maxWidth="160dp"
                    android:textColor="#FFE8EEF8"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="AuraStar" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvChatLine"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxWidth="240dp"
                    android:textColor="#FFDA81"
                    android:textSize="14sp"
                    tools:text="مرحبا بالجميع" />

                <ImageView
                    android:id="@+id/imgChatGift"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/chatBadgesRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvVipChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/bg_chip_vip"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="1dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="VIP3"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tvLevelChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/bg_chip_level"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="1dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="Lv.12"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tvWealthChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/bg_chip_wealth"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="1dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="❤ 12"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tvCharmChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_charm"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="1dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/btnChatUserMore"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvChatMeta"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
