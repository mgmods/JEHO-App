<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="horizontal"
    android:layoutDirection="ltr"
    android:paddingStart="2dp"
    android:paddingTop="2dp"
    android:paddingEnd="8dp"
    android:paddingBottom="2dp">

    <LinearLayout
        android:id="@+id/chatBubbleRoot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_room_chat_bubble"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="top"
        android:maxWidth="340dp"
        android:minWidth="0dp"
        android:orientation="horizontal"
        android:layoutDirection="ltr"
        android:paddingStart="9dp"
        android:paddingTop="6dp"
        android:paddingEnd="11dp"
        android:paddingBottom="6dp">

        <FrameLayout
            android:id="@+id/chatAvatarWrap"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="7dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ImageView
                android:id="@+id/imgChatAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_tab_me" />

            <ImageView
                android:id="@+id/imgChatFrame"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <com.Dramizo.Series.util.HostSignalView
                android:id="@+id/webChatHostSignal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:elevation="3dp"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layoutDirection="ltr">

            <LinearLayout
                android:id="@+id/chatNameRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layoutDirection="ltr">

                <TextView
                    android:id="@+id/tvHostChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/bg_seat_host_chip"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="1dp"
                    android:text="المبدع"
                    android:textColor="@color/aurora_gold"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tvChatName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:ellipsize="end"
                    android:focusable="true"
                    android:maxLines="1"
                    android:maxWidth="116dp"
                    android:textColor="#FFE8EEF8"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="AuraStar" />

                <LinearLayout
                    android:id="@+id/chatBadgesRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/imgChatVipBadge"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="2dp"
                        android:contentDescription="VIP"
                        android:scaleType="fitCenter"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvChatCpChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="2dp"
                        android:background="@drawable/bg_cp_cv_badge"
                        android:includeFontPadding="false"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="1dp"
                        android:text="CP"
                        android:textColor="#FFFFFFFF"
                        android:textSize="8sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvChatPublicId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="2dp"
                        android:background="@drawable/bg_vanity_chip"
                        android:includeFontPadding="false"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="1dp"
                        android:textColor="#FFFFFFFF"
                        android:textSize="8sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/imgChatMedal1"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="1dp"
                        android:contentDescription="ميدالية"
                        android:scaleType="fitCenter"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/imgChatMedal2"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="1dp"
                        android:contentDescription="ميدالية"
                        android:scaleType="fitCenter"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/imgChatMedal3"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="ميدالية"
                        android:scaleType="fitCenter"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvVipChip"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvChatLevelLegacy"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvChatWealthLegacy"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvChatCharmLegacy"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layoutDirection="ltr">

                <TextView
                    android:id="@+id/tvChatLine"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxWidth="226dp"
                    android:textColor="#FFDA81"
                    android:textSize="13sp"
                    tools:text="مرحبا بالجميع" />

                <ImageView
                    android:id="@+id/imgChatGift"
                    android:layout_width="23dp"
                    android:layout_height="23dp"
                    android:layout_marginStart="5dp"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>



        <TextView
            android:id="@+id/btnChatUserMore"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvChatMeta"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>