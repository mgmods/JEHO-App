<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_user_card_sheet"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="22dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="@drawable/bg_sheet_handle" />

    <FrameLayout
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:layout_marginTop="12dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <ImageView
            android:id="@+id/imgUserAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_tab_me" />

        <ImageView
            android:id="@+id/imgUserFrame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/imgUserHostBadge"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvUserName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#111827"
        android:textSize="18sp"
        android:textStyle="bold"
        tools:text="AuraStar" />

    <TextView
        android:id="@+id/tvUserId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#6B7280"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="ID 1234567"
        tools:visibility="visible" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp">

            <TextView
                android:id="@+id/chipVip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_vip"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="VIP12"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/chipMember"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_chip_level"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Lv.12" />

            <TextView
                android:id="@+id/chipCharm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_chip_charm"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="شعبية 2.1K" />

            <TextView
                android:id="@+id/chipWealth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_chip_wealth"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="ثروة 8.4K" />

            <TextView
                android:id="@+id/chipFirstDay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_chip_reward"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="اليوم الأول"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnHi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_chip_dark"
                android:paddingHorizontal="14dp"
                android:paddingVertical="4dp"
                android:text="Hi"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold|italic"
                android:visibility="gone" />
        </LinearLayout>
    </HorizontalScrollView>

    <HorizontalScrollView
        android:id="@+id/rowHostTasks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="المهام"
                android:textColor="#6B7280"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chipTaskChat5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_user_card_action"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="5 رسائل"
                android:textColor="#B45309"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/chipTaskChat10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_user_card_action"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="10 رسائل"
                android:textColor="#B45309"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/chipTaskInvite40"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_user_card_action"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="دعوة +40◆"
                android:textColor="#B45309"
                android:textSize="11sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/tvUserActionsTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="start"
        android:text="خيارات المستخدم والتفاعل"
        android:textColor="#374151"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/actProfile"
            style="@style/Widget.AuraLive.UserCardAction"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="الملف" />

        <TextView
            android:id="@+id/actGift"
            style="@style/Widget.AuraLive.UserCardAction"
            android:layout_width="0dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="هدية"
            android:textColor="#BE123C" />

        <TextView
            android:id="@+id/actChat"
            style="@style/Widget.AuraLive.UserCardAction"
            android:layout_width="0dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="رسالة"
            android:textColor="#1D4ED8" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/actFollow"
            style="@style/Widget.AuraLive.UserCardAction"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="متابعة" />

        <TextView
            android:id="@+id/actFriend"
            style="@style/Widget.AuraLive.UserCardAction"
            android:layout_width="0dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="صداقة" />

        <TextView
            android:id="@+id/actAt"
            style="@style/Widget.AuraLive.UserCardAction"
            android:layout_width="0dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@mention" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/actXo"
            style="@style/Widget.AuraLive.UserCardAction"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/xo_challenge"
            android:textColor="#0F766E"
            android:visibility="gone" />

        <TextView
            android:id="@+id/actInviteGuest"
            style="@style/Widget.AuraLive.UserCardAction"
            android:layout_width="0dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="دعوة للمايك"
            android:textColor="#0F766E"
            android:visibility="gone" />

        <TextView
            android:id="@+id/actTaskInvite"
            style="@style/Widget.AuraLive.UserCardAction"
            android:layout_width="0dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="مهمة +40◆"
            android:textColor="#B45309"
            android:visibility="gone" />

        <TextView
            android:id="@+id/actMute"
            style="@style/Widget.AuraLive.UserCardAction"
            android:layout_width="0dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="كتم"
            android:textColor="#B45309"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowMicControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/actOpenMic"
            style="@style/Widget.AuraLive.UserCardAction"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="فتح مايك"
            android:textColor="#0F766E" />

        <TextView
            android:id="@+id/actCloseMic"
            style="@style/Widget.AuraLive.UserCardAction"
            android:layout_width="0dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="إغلاق مايك"
            android:textColor="#BE123C" />

        <TextView
            android:id="@+id/actUnmute"
            style="@style/Widget.AuraLive.UserCardAction"
            android:layout_width="0dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="فك الكتم"
            android:textColor="#047857" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/actModerator"
            style="@style/Widget.AuraLive.UserCardAction"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="مشرف"
            android:textColor="#0F766E"
            android:visibility="gone" />

        <TextView
            android:id="@+id/actKick"
            style="@style/Widget.AuraLive.UserCardAction"
            android:layout_width="0dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="طرد"
            android:textColor="#B45309"
            android:visibility="gone" />

        <TextView
            android:id="@+id/actBan"
            style="@style/Widget.AuraLive.UserCardAction"
            android:layout_width="0dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/ban_user"
            android:textColor="#BE123C"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/actReport"
        style="@style/Widget.AuraLive.UserCardAction"
        android:layout_width="match_parent"
        android:layout_marginTop="8dp"
        android:text="إبلاغ"
        android:textColor="#BE123C" />

    <GridLayout
        android:id="@+id/userActionsGrid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</LinearLayout>
