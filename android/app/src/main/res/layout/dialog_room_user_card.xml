<?xml version="1.0" encoding="utf-8"?>
<!-- Mikoo dialog_user_info inspired room user card (ids mapped to JEHO handlers). -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/clUserCardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Dark sheet body -->
    <View
        android:id="@+id/userCardBg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="52dp"
        android:background="@drawable/bg_user_card_sheet"
        app:layout_constraintBottom_toBottomOf="@id/moreActionsBlock"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/imgVipHead" />

    <!-- VIP head banner (ic_head_vip / iv_bg_vip) -->
    <ImageView
        android:id="@+id/imgVipHead"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="28dp"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:visibility="gone"
        app:layout_constraintDimensionRatio="1125:330"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible" />

    <!-- Avatar + VIP frame (iv_vip_tou) -->
    <FrameLayout
        android:id="@+id/avatar_layout"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/imgUserAvatar"
            android:layout_width="86dp"
            android:layout_height="86dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_tab_me" />

        <ImageView
            android:id="@+id/imgUserFrame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/imgUserHostBadge"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/ll_level_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/avatar_layout">

        <TextView
            android:id="@+id/tvUserName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxWidth="180dp"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="عمار" />

        <ImageView
            android:id="@+id/imgGender"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="6dp"
            android:contentDescription="@null"
            android:visibility="gone"
            tools:src="@drawable/ic_gender_female"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvOnlineStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_user_card_stat_cell"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:textColor="#FF7CFFB2"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="متصل"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- ID / flag / copy / level -->
    <LinearLayout
        android:id="@+id/id_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_level_name">

        <TextView
            android:id="@+id/tvUserId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#99FFFFFF"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="ID:5764421"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/btnCopyId"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="نسخ"
            android:src="@drawable/icon_copy"
            android:visibility="gone"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/imgCountryFlag"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="10dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <TextView
            android:id="@+id/chipMember"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_user_card_id_chip"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:textColor="#E0F7FA"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="30" />
    </LinearLayout>

    <!-- Mikoo: three counters under ID (followers / fans / visitors) -->
    <LinearLayout
        android:id="@+id/rowSocialStats"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_user_card_stat_cell"
        android:orientation="horizontal"
        android:paddingVertical="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/id_layout">

        <LinearLayout
            android:id="@+id/cellStatFollowers"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvStatFollowing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/user_card_stat_following"
                android:textColor="#99FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cellStatFans"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvStatFans"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/user_card_stat_fans"
                android:textColor="#99FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cellStatVisitors"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvStatVisitors"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/user_card_stat_visitors"
                android:textColor="#99FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- VIP medal + stats -->
    <LinearLayout
        android:id="@+id/ll_model"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rowSocialStats">

        <ImageView
            android:id="@+id/imgEntryRide"
            android:layout_width="36dp"
            android:layout_height="25dp"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:visibility="gone"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/imgVipMedal"
            android:layout_width="43dp"
            android:layout_height="25dp"
            android:layout_marginStart="6dp"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/chipVip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_chip_vip"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="VIP3"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/chipCharm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_chip_charm"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="15" />

        <TextView
            android:id="@+id/chipWealth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_chip_wealth"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="24" />

        <TextView
            android:id="@+id/chipFirstDay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_chip_reward"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="اليوم الأول"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnHi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_chip_dark"
            android:paddingHorizontal="14dp"
            android:paddingVertical="4dp"
            android:text="Hi"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold|italic"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Agency / guild strip (Mikoo clGuildInfo + icon_info_guild_bg_base_lvN) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rowAgency"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="14dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_model"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/imgAgencyBannerBg"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="14dp"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/icon_info_guild_bg_base_lv1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1035:219"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Logo + Lv under image (Mikoo guild strip). No heart/frame overlay. -->
        <LinearLayout
            android:id="@+id/agencyLogoWrap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="@id/imgAgencyBannerBg"
            app:layout_constraintStart_toStartOf="@id/imgAgencyBannerBg"
            app:layout_constraintTop_toTopOf="@id/imgAgencyBannerBg">

            <ImageView
                android:id="@+id/imgAgencyLogo"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_voice_seat_circle"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/icon_agency" />

            <TextView
                android:id="@+id/tvAgencyLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:background="@drawable/bg_top_lv_guild"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="36dp"
                android:paddingHorizontal="5dp"
                android:paddingVertical="1dp"
                android:textColor="#FFFFCE00"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="visible"
                tools:text="Lv.3" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="12dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="@id/imgAgencyBannerBg"
            app:layout_constraintEnd_toEndOf="@id/imgAgencyBannerBg"
            app:layout_constraintStart_toEndOf="@id/agencyLogoWrap"
            app:layout_constraintTop_toTopOf="@id/imgAgencyBannerBg">

            <TextView
                android:id="@+id/tvAgencyName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="الوكالة" />

            <TextView
                android:id="@+id/tvAgencyGid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#99FFFFFF"
                android:textSize="12sp"
                tools:text="GID:1895" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrierAfterGuild"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="ll_model,rowAgency" />

    <TextView
        android:id="@+id/tvPropertyTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:text="@string/user_card_property_title"
        android:textColor="#B3FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barrierAfterGuild" />

    <!-- Mikoo property strip: عائلة · داعمون · أصدقاء -->
    <LinearLayout
        android:id="@+id/rowProperty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvPropertyTitle">

        <LinearLayout
            android:id="@+id/propFamily"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_user_card_stat_cell"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_me_agency" />

            <TextView
                android:id="@+id/tvPropFamily"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/user_card_prop_family"
                android:textColor="#E6FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/propSupporters"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_user_card_stat_cell"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPropSupportersCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/user_card_prop_supporters"
                android:textColor="#99FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/propFriends"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="@drawable/bg_user_card_stat_cell"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPropFriendsCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/user_card_prop_friends"
                android:textColor="#99FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/rowHostTasks"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="12dp"
        android:scrollbars="none"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rowProperty">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="4dp">

            <TextView
                android:id="@+id/chipTaskChat5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_user_card_action"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="5 رسائل"
                android:textColor="#FBBF24"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/chipTaskChat10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_user_card_action"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="10 رسائل"
                android:textColor="#FBBF24"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/chipTaskInvite40"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_user_card_action"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="دعوة +40◆"
                android:textColor="#FBBF24"
                android:textSize="11sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Mikoo bottom_layout: gift / chat / attention / @  as real icons -->
    <LinearLayout
        android:id="@+id/bottom_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingBottom="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rowHostTasks">

        <ImageView
            android:id="@+id/actGift"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="هدية"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/icon_gift" />

        <ImageView
            android:id="@+id/actChat"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="رسالة"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/icon_chat" />

        <ImageView
            android:id="@+id/actFollow"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="متابعة"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/icon_attention" />

        <ImageView
            android:id="@+id/actAt"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="@mention"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/icon_focus" />
    </LinearLayout>

    <!-- Secondary admin actions keep TextView style under primary icons -->
    <LinearLayout
        android:id="@+id/moreActionsBlock"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:background="@drawable/bg_user_card_sheet"
        android:paddingBottom="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bottom_layout">

        <TextView
            android:id="@+id/tvUserActionsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="المزيد"
            android:textColor="#99FFFFFF"
            android:textSize="12sp" />

        <LinearLayout
