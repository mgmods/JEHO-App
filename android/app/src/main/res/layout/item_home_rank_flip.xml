<?xml version="1.0" encoding="utf-8"?>
<!-- One page of Mikoo rank mini-banner (ثروة / جاذبيه) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/imgRankCover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/home_bg_wealth" />

    <TextView
        android:id="@+id/tvRankTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="6dp"
        android:text="@string/ranking_wealth"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="4dp"
        android:gravity="bottom|center_horizontal"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="27dp"
            android:layout_height="27dp"
            android:layout_marginEnd="2dp">

            <ImageView
                android:id="@+id/imgRank2"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_seat_avatar_clip"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_tab_me" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_ranklist_second" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp">

            <ImageView
                android:id="@+id/imgRank1"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_seat_avatar_clip"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_tab_me" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_ranlist_first" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="25dp"
            android:layout_height="28dp"
            android:layout_marginStart="2dp">

            <ImageView
                android:id="@+id/imgRank3"
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_seat_avatar_clip"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_tab_me" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_ranklist_third" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
