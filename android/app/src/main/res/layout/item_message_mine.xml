<?xml version="1.0" encoding="utf-8"?>
<!-- Outgoing (me) — bubble right, avatar far right (voice cluster). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <TextView
        android:id="@+id/tvDaySeparator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="10dp"
        android:paddingBottom="12dp"
        android:textColor="@color/text_hint"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/rootRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="end|bottom"
        android:layoutDirection="ltr"
        android:orientation="horizontal"
        android:paddingStart="48dp"
        android:paddingEnd="6dp">

        <FrameLayout
            android:id="@+id/bubbleColumn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="292dp">

            <include
                layout="@layout/item_message_bubble_inner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/avatarWrap"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="2dp"
            android:clipChildren="true"
            android:clipToPadding="true">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_tab_me"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.AuraLive.Circle" />

            <ImageView
                android:id="@+id/imgFrame"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/imgHostBadge"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
