<?xml version="1.0" encoding="utf-8"?>
<!-- From Mikoo view_music_library_empty -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_searchEmpty"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="122dp"
    android:gravity="center"
    android:orientation="vertical"
    android:visibility="gone">

    <ImageView
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:contentDescription="@null"
        android:src="@mipmap/icon_music_list_empty" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginVertical="10dp"
        android:text="@string/music_list_play_empty_tips1"
        android:textColor="@color/color_7D7E80"
        android:textSize="16sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/music_list_play_empty_tips2"
        android:textColor="@color/color_7D7E80"
        android:textSize="14sp" />
</LinearLayout>
