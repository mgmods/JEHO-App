<?xml version="1.0" encoding="utf-8"?>
<!-- Immersive Mikoo game host: black stage + aspect-fit WebView (no app chrome). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/gameRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:fitsSystemWindows="false">

    <!-- Centered stage sized to Cocos design aspect (~750×1334). -->
    <FrameLayout
        android:id="@+id/gameStage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:background="#FF000000">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FF000000"
            android:overScrollMode="never" />
    </FrameLayout>

    <!-- Cover splash until Cocos gameLoaded (not just HTML pageFinished). -->
    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6000000"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/imgGameCover"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:layout_marginBottom="36dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/gift_pro_14" />

        <ProgressBar
            android:id="@+id/progressGame"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:layout_marginTop="88dp"
            android:indeterminate="true"
            android:indeterminateTint="#FFFFC84A" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="140dp"
            android:textColor="#CCFFFFFF"
            android:textSize="14sp" />
    </FrameLayout>

    <!-- Floating close — Mikoo games already have in-game close; this is escape hatch. -->
    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="start|top"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_game_close_fab"
        android:contentDescription="@string/back"
        android:padding="10dp"
        android:src="@drawable/ic_arrow_back"
        app:tint="@color/white" />

    <TextView
        android:id="@+id/btnGameRewardAd"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_gravity="end|top"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_game_close_fab"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/game_reward_ad"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Kept for older matchmaking callers; always gone for Mikoo. -->
    <LinearLayout
        android:id="@+id/matchOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6080E18"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:indeterminateTint="@color/aurora_gold" />

        <TextView
            android:id="@+id/tvMatchStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvMatchHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/rowMatchedPlayers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelMatch"
            style="@style/Widget.AuraLive.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
