<?xml version="1.0" encoding="utf-8"?>
<!-- Plain text / agency-code official news bubble. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="6dp">

    <ImageView
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_seat_avatar_clip"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/jeho_logo" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:background="@drawable/bg_chat_bubble_peer"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <TextView
            android:id="@+id/tvBubbleTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="تم تفعيل وكالتك" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgBubbleMedia"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvBubbleBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            tools:text="وكالتك نشطة. كود التفعيل: ABCD1234" />

        <LinearLayout
            android:id="@+id/rowActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="start"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/btnCopyCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_level"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="@string/agency_copy_code"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/btnOpenLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_vip"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="@string/official_news_open_link"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvBubbleTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_hint"
            android:textSize="10sp"
            tools:text="اليوم 10:42" />
    </LinearLayout>
</LinearLayout>
