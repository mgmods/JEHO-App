<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <ImageView
        android:id="@+id/imgDialogBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:contentDescription="@null" />

    <LinearLayout
        android:id="@+id/clSignIn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_sign_in_panel"
        android:clipToOutline="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="20dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:background="@drawable/bg_sign_in_header">

            <TextView
                android:id="@+id/tvTitle2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingHorizontal="64dp"
                android:text="@string/check_in_title"
                android:textColor="#FFFFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/imgSignLogo"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="14dp"
                android:scaleType="fitCenter"
                android:visibility="gone"
                android:contentDescription="شعار مكافآت تسجيل الدخول" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="18dp"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="مكافآت سبعة أيام — اختر هديتك واستلمها يوميًا"
            android:textColor="#FF218653"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSignHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="18dp"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:textColor="#FF667085"
            android:textSize="13sp" />

        <GridLayout
            android:id="@+id/gridDays"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="10dp"
            android:alignmentMode="alignMargins"
            android:columnCount="4"
            android:useDefaultMargins="false" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:background="#FFE5E7EB" />

        <TextView
            android:id="@+id/bltvCheckIn"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginHorizontal="28dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_sign_in_btn"
            android:gravity="center"
            android:text="@string/check_in_action"
            android:textAllCaps="false"
            android:textColor="#FF218653"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/successPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_sign_in_panel"
        android:clipToOutline="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="22dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvClaimEnvelope"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_sign_in_header"
            android:gravity="center"
            android:text="✉"
            android:textColor="#FFFFFFFF"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvClaimSuccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="تم الاستلام بنجاح"
            android:textColor="#FF218653"
            android:textSize="19sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/imgClaimReward"
            android:layout_width="132dp"
            android:layout_height="132dp"
            android:layout_marginTop="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_gold_coin"
            android:contentDescription="المكافأة التي تم استلامها" />

        <TextView
            android:id="@+id/tvClaimRewardName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="#FF232D28"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnClaimOk"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_sign_in_btn"
            android:gravity="center"
            android:text="حسناً"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
