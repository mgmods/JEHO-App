<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF7F8FA"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/back"
                android:padding="10dp"
                android:src="@drawable/ic_arrow_back" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="خصوصية التتبع"
                android:textColor="#FF182230"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_settings_row"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="التحكم بظهور الغرفة الحالية"
                android:textColor="#FF202B3A"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="اختر من يستطيع رؤية زر تتبعك عندما تكون داخل غرفة صوتية."
                android:textColor="#FF7A8492"
                android:textSize="13sp" />
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchEnabled"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="12dp"
                android:text="السماح بتتبع الغرفة"
                android:textColor="#FF202B3A"
                android:textStyle="bold" />
        </LinearLayout>
        <RadioGroup
            android:id="@+id/groupAudience"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_settings_row"
            android:orientation="vertical"
            android:padding="12dp">
            <RadioButton
                android:id="@+id/radioEveryone"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:paddingHorizontal="8dp"
                android:text="الجميع"
                android:textColor="#FF202B3A"
                android:textSize="15sp" />
            <RadioButton
                android:id="@+id/radioFollowers"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:paddingHorizontal="8dp"
                android:text="المتابعون"
                android:textColor="#FF202B3A"
                android:textSize="15sp" />
            <RadioButton
                android:id="@+id/radioFriends"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:paddingHorizontal="8dp"
                android:text="الأصدقاء"
                android:textColor="#FF202B3A"
                android:textSize="15sp" />
            <RadioButton
                android:id="@+id/radioNobody"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:paddingHorizontal="8dp"
                android:text="لا أحد"
                android:textColor="#FF202B3A"
                android:textSize="15sp" />
        </RadioGroup>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="8dp"
            android:text="عند إيقاف السماح، لن يتمكن الآخرون من معرفة الغرفة التي تتواجد فيها."
            android:textColor="#FF7A8492"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
