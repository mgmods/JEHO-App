<?xml version="1.0" encoding="utf-8"?>
<!-- Light app private chat â€” header / list / composer (mock-accurate). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_chat_screen">

    <ImageView
        android:id="@+id/imgThemeBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/contentColumn"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:id="@+id/headerBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chat_header_bar"
            android:clipChildren="false"
            android:gravity="center_vertical"
            android:layoutDirection="locale"
            android:minHeight="58dp"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp">

            <FrameLayout
                android:id="@+id/btnBack"
                android:layout_width="42dp"
                android:layout_height="48dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/imgBackIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/back"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/text_primary" />
            </FrameLayout>

            <!-- Peer avatar + purple ring -->
            <FrameLayout
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="2dp"
                android:clipChildren="false">

                <View
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_chat_avatar_ring" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgPeerAvatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_default_avatar"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.AuraLive.Circle" />

                <ImageView
                    android:id="@+id/imgPeerFrame"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/imgPeerHostBadge"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="bottom|end"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <!-- Green online pill on avatar (mock) -->
                <View
                    android:id="@+id/dotPeerOnline"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="1dp"
                    android:layout_marginBottom="1dp"
                    android:background="@drawable/bg_online_dot_ring" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvPeerName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxWidth="150dp"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="Lana" />

                    <!-- Gender verification only when peer is verified (bound in Java) -->
                    <ImageView
                        android:id="@+id/imgPeerVerified"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="5dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_gender_verified"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvPeerStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/chat_status_online"
                        android:textColor="@color/aurora_success"
                        android:textSize="12sp"
                        tools:text="Online" />

                    <TextView
                        android:id="@+id/tvPeerUsername"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/imgChatCall"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="4dp"
                android:visibility="gone"
                android:background="@drawable/bg_chat_header_icon_circle"
                android:contentDescription="@null"
                android:padding="9dp"
                android:src="@drawable/ic_chat_call"
                app:tint="@color/text_primary" />

            <ImageView
                android:id="@+id/imgChatVideo"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:visibility="gone"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_chat_header_icon_circle"
                android:contentDescription="@null"
                android:padding="9dp"
                android:src="@drawable/ic_chat_video"
                app:tint="@color/text_primary" />

            <!-- legacy heart id kept for bind compatibility -->
            <ImageView
                android:id="@+id/imgChatHeart"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/btnChatMenu"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/imgChatMenu"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/chat_menu"
                    android:src="@drawable/ic_chat_menu_more"
                    app:tint="@color/text_primary" />
            </FrameLayout>
        </LinearLayout>

        <!-- Peer strip optional (usually gone) -->
        <FrameLayout
            android:id="@+id/peerProfileStrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/imgPeerStripBg"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/p2p_nanbg" />

            <TextView
                android:id="@+id/btnUpgradeRelation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/p2p_send"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="@string/upgrade_relation"
                android:textColor="@color/white"
                android:textSize="10sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="80dp"
                android:visibility="gone">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgStripAvatar"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_default_avatar"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.AuraLive.Circle" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvStripName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxWidth="140dp"
                            android:maxLines="1"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/imgStripFlag"
                            android:layout_width="20dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="5dp"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter"
                            android:visibility="gone" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/rowStripLevels"
                        android:layout_width="wrap_content"
                        android:layout_height="18dp"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvStripLv1"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_chip_level"
                            android:gravity="center"
                            android:minWidth="34dp"
                            android:paddingHorizontal="6dp"
                            android:textColor="@color/white"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvStripLv2"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginStart="5dp"
                            android:background="@drawable/bg_chip_charm"
                            android:gravity="center"
                            android:minWidth="34dp"
                            android:paddingHorizontal="6dp"
                            android:textColor="@color/white"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvStripLv3"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginStart="5dp"
                            android:background="@drawable/bg_chip_wealth"
                            android:gravity="center"
                            android:minWidth="34dp"
                            android:paddingHorizontal="6dp"
                            android:textColor="@color/white"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingHorizontal="4dp"
            android:paddingTop="4dp"
            android:paddingBottom="10dp" />

        <TextView
            android:id="@+id/tvTyping"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/editBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F5F5F7"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/editing_message"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEditPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_hint"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnCancelEdit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="@string/cancel"
                android:textColor="@color/gift_accent"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/replyBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F5F5F7"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:visibility="gone">

            <View
                android:layout_width="3dp"
                android:layout_height="36dp"
                android:background="@color/gift_accent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvReplyTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/reply"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvReplyPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_hint"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnCancelReply"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/cancel"
                android:padding="8dp"
                android:src="@drawable/ic_pro_close"
                app:tint="@color/text_primary" />
        </LinearLayout>

        <!-- Composer: + | pill input+emoji | mic/send -->
        <LinearLayout
            android:id="@+id/inputBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bg_light"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="12dp">

            <FrameLayout
                android:id="@+id/btnAttach"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_chat_circle_action"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/imgChatImage"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/pick_gallery_photo"
                    android:src="@drawable/ic_chat_plus"
                    app:tint="@color/white" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/composerShell"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chat_input_field"
                android:minHeight="46dp">

                <EditText
                    android:id="@+id/etMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:background="@null"
                    android:hint="@string/msg_input_hint"
                    android:imeOptions="actionSend"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxHeight="96dp"
                    android:maxLines="4"
                    android:minHeight="46dp"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="42dp"
                    android:paddingBottom="10dp"
                    android:textAlignment="viewStart"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:textCursorDrawable="@null"
                    android:textDirection="locale"
                    android:textSize="14sp" />

                <FrameLayout
                    android:id="@+id/btnChatEmoji"
                    android:layout_width="40dp"
                    android:layout_height="46dp"
                    android:layout_gravity="end|center_vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/emoji"
                        android:src="@drawable/ic_p2p_modify_emoji"
                        app:tint="@color/text_secondary" />
                </FrameLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btnChatGift"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/imgChatGift"
                    android:layout_width="0dp"
                    android:layout_height="0dp" />
            </FrameLayout>

            <!-- Mic when empty; Send when typing (mock) -->
            <FrameLayout
                android:id="@+id/btnVoice"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_chat_circle_action"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/imgChatVoice"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/voice_message"
                    android:src="@drawable/ic_pro_mic"
                    app:tint="@color/white" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btnSend"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_chat_circle_action"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/imgChatSend"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/send_btn"
                    android:src="@drawable/ic_pro_send"
                    app:tint="@color/white" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Voice record overlay -->
    <FrameLayout
        android:id="@+id/voiceRecordOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/bg_light"
        android:clickable="true"
        android:elevation="24dp"
        android:focusable="true"
        android:minHeight="220dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/voiceRecordBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingVertical="24dp">

            <FrameLayout
                android:id="@+id/voiceMicCircle"
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:background="@drawable/bg_chat_circle_action">

                <View
                    android:id="@+id/voicePulseOuter"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <View
                    android:id="@+id/voicePulseInner"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <View
                    android:id="@+id/voiceRecDot"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_p2p_modify_audio"
                    app:tint="@color/text_primary" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvVoiceHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/press_to_record"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvVoiceTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="0:00"
                android:textColor="@color/text_hint"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="0:12" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnVoiceCancel"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cancel"
                    android:padding="12dp"
                    android:src="@drawable/ic_voice_trash"
                    app:tint="#E53935" />

                <ImageView
                    android:id="@+id/btnVoiceSend"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="28dp"
                    android:background="@drawable/bg_chat_circle_action"
                    android:contentDescription="@string/send_btn"
                    android:padding="14dp"
                    android:src="@drawable/ic_pro_send"
                    app:tint="@color/white" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>




