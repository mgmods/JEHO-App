<?xml version="1.0" encoding="utf-8"?>
<!-- Mikoo nim_message_activity / p2p conversation chrome -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF3F6F5">

    <ImageView
        android:id="@+id/imgThemeBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/contentColumn"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Title bar -->
        <LinearLayout
            android:id="@+id/headerBar"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@color/white"
            android:clipChildren="false"
            android:gravity="center_vertical"
            android:layoutDirection="locale"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <FrameLayout
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/imgBackIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/back"
                    android:src="@drawable/ic_p2p_message_back" />
            </FrameLayout>

            <!-- Hidden avatar pack kept for code that binds peer wear -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/imgPeerAvatar"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:contentDescription="@null" />

                <ImageView
                    android:id="@+id/imgPeerFrame"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/imgPeerHostBadge"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPeerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxWidth="160dp"
                    android:maxLines="1"
                    android:textColor="#FF333333"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="علاء" />

                <TextView
                    android:id="@+id/tvPeerUsername"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FFB2B2B2"
                    android:textSize="14sp"
                    tools:text="(ID:2477164)" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvPeerStatus"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/imgChatHeart"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:contentDescription="@null"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/p2p_yg" />

            <FrameLayout
                android:id="@+id/btnChatMenu"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/imgChatMenu"
                    android:layout_width="24dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/chat_menu"
                    android:scaleType="fitCenter"
                    android:src="@drawable/p2p_more" />
            </FrameLayout>
        </LinearLayout>

        <!-- Peer strip (Mikoo p2p_zl_cl) — fixed height avoids wrap+ratio circular constraint -->
        <FrameLayout
            android:id="@+id/peerProfileStrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFF3F6F5"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/imgPeerStripBg"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/p2p_nanbg" />

            <TextView
                android:id="@+id/btnUpgradeRelation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/p2p_send"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="@string/upgrade_relation"
                android:textColor="@color/white"
                android:textSize="10sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="80dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgStripAvatar"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_default_avatar"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.AuraLive.Circle" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvStripName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxWidth="140dp"
                            android:maxLines="1"
                            android:textColor="#FF222222"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            tools:text="علاء" />

                        <ImageView
                            android:id="@+id/imgStripFlag"
                            android:layout_width="20dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="5dp"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/rowStripLevels"
                        android:layout_width="wrap_content"
                        android:layout_height="18dp"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvStripLv1"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_chip_level"
                            android:gravity="center"
                            android:minWidth="34dp"
                            android:paddingHorizontal="6dp"
                            android:textColor="@color/white"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            tools:text="14" />

                        <TextView
                            android:id="@+id/tvStripLv2"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginStart="5dp"
                            android:background="@drawable/bg_chip_charm"
                            android:gravity="center"
                            android:minWidth="34dp"
                            android:paddingHorizontal="6dp"
                            android:textColor="@color/white"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            tools:text="12" />

                        <TextView
                            android:id="@+id/tvStripLv3"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginStart="5dp"
                            android:background="@drawable/bg_chip_wealth"
                            android:gravity="center"
                            android:minWidth="34dp"
                            android:paddingHorizontal="6dp"
                            android:textColor="@color/white"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            tools:text="12" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_weight="1"
            android:paddingHorizontal="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/tvTyping"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/editBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#33000000"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/editing_message"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEditPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_hint"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnCancelEdit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="@string/cancel"
                android:textColor="@color/aurora_gold"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/replyBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#22000000"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:visibility="gone">

            <View
                android:layout_width="3dp"
                android:layout_height="36dp"
                android:background="#FF43D3A2" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvReplyTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/reply"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvReplyPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_hint"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnCancelReply"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/cancel"
                android:padding="8dp"
                android:src="@drawable/ic_pro_close"
                app:tint="@color/text_primary" />
        </LinearLayout>

        <!-- Bottom: text row + icon strip (Mikoo) -->
        <LinearLayout
            android:id="@+id/inputBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFF0F0F0"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="2dp">

            <RelativeLayout
                android:id="@+id/composerShell"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:paddingTop="8dp">

                <EditText
                    android:id="@+id/etMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="52dp"
                    android:background="@drawable/bg_chat_input_field"
                    android:hint="@string/msg_input_hint"
                    android:imeOptions="actionSend"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxHeight="72dp"
                    android:maxLines="4"
                    android:minHeight="40dp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:textAlignment="viewStart"
                    android:textColor="#FF333333"
                    android:textColorHint="#FFCCCCCC"
                    android:textCursorDrawable="@null"
                    android:textDirection="locale"
                    android:textSize="13sp" />

                <FrameLayout
                    android:id="@+id/btnSend"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/imgChatSend"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/send_btn"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_p2p_message_send" />
                </FrameLayout>
            </RelativeLayout>

            <!-- Mikoo icon order: emoji · audio · gift · pic (RTL reverses to match screenshots) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:gravity="center"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/btnChatEmoji"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/emoji"
                        android:src="@drawable/ic_p2p_modify_emoji" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/btnVoice"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/imgChatVoice"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/voice_message"
                        android:src="@drawable/ic_p2p_modify_audio" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/btnChatGift"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/imgChatGift"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/gifts"
                        android:src="@drawable/ic_p2p_gift" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/btnAttach"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/imgChatImage"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/pick_gallery_photo"
                        android:src="@drawable/ic_p2p_pic" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Mikoo voice panel: big green record circle -->
    <FrameLayout
        android:id="@+id/voiceRecordOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#FFF0F0F0"
        android:clickable="true"
        android:elevation="24dp"
        android:focusable="true"
        android:minHeight="220dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/voiceRecordBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingVertical="24dp">

            <FrameLayout
                android:id="@+id/voiceMicCircle"
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:background="@drawable/shape_dialog_btn_audio_record_press_12">

                <View
                    android:id="@+id/voicePulseOuter"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <View
                    android:id="@+id/voicePulseInner"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <View
                    android:id="@+id/voiceRecDot"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvVoiceHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/press_to_record"
                android:textColor="#FF333333"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvVoiceTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="0:00"
                android:textColor="#FF666666"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="0:12" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnVoiceCancel"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cancel"
                    android:padding="12dp"
                    android:src="@drawable/ic_voice_trash"
                    app:tint="#E53935" />

                <ImageView
                    android:id="@+id/btnVoiceSend"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="28dp"
                    android:background="@drawable/bg_voice_send_circle"
                    android:contentDescription="@string/send_btn"
                    android:padding="14dp"
                    android:src="@drawable/ic_p2p_message_send"
                    app:tint="@android:color/white" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
