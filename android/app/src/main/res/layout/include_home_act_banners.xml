<?xml version="1.0" encoding="utf-8"?>
<!-- Mikoo home_act_banner_layout: ثروة قلاب + CP + نشاط -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/actBannerLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginBottom="10dp"
    android:orientation="horizontal"
    android:layoutDirection="ltr">

    <ViewFlipper
        android:id="@+id/rankBannerFlip"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_weight="1.7"
        android:autoStart="true"
        android:flipInterval="3000"
        android:inAnimation="@android:anim/fade_in"
        android:outAnimation="@android:anim/fade_out" />

    <View
        android:layout_width="6dp"
        android:layout_height="1dp" />

    <FrameLayout
        android:id="@+id/cpBannerCard"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_weight="1"
        android:background="@drawable/home_bg_cp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:text="CP"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="6dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgCpLeft"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/bg_seat_avatar_clip"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_tab_me" />

            <ImageView
                android:layout_width="28dp"
                android:layout_height="22dp"
                android:layout_marginHorizontal="2dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/icon_nan" />

            <ImageView
                android:id="@+id/imgCpRight"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/bg_seat_avatar_clip"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_tab_me" />
        </LinearLayout>
    </FrameLayout>

    <View
        android:layout_width="6dp"
        android:layout_height="1dp" />

    <FrameLayout
        android:id="@+id/activityBannerCard"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_weight="1"
        android:background="@drawable/home_top_invite_bg"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground">

        <TextView
            android:id="@+id/tvActivityBannerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:text="@string/task_center"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvActivityBannerHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_margin="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="مهام يومية · مكافآت"
            android:textColor="@color/white"
            android:textSize="10sp" />
    </FrameLayout>
</LinearLayout>
