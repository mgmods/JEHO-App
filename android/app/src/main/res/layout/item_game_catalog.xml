<?xml version="1.0" encoding="utf-8"?>
<!-- Transparent tile: cover + title only — no white card plate -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:layout_marginBottom="10dp"
    android:foreground="?attr/selectableItemBackgroundBorderless"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="4dp"
    android:paddingTop="4dp"
    android:paddingBottom="2dp">

    <FrameLayout
        android:layout_width="84dp"
        android:layout_height="84dp">

        <!-- Soft ambient glow under cover (no solid plate) -->
        <View
            android:layout_width="72dp"
            android:layout_height="18dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="2dp"
            android:alpha="0.35"
            android:background="@drawable/bg_game_cover_shadow" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgCover"
            android:layout_width="78dp"
            android:layout_height="78dp"
            android:layout_gravity="center_horizontal|top"
            android:contentDescription="@null"
            android:elevation="6dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_game_placeholder"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.AuraLive.Rounded18"
            app:strokeColor="#40FFFFFF"
            app:strokeWidth="1.5dp" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:minHeight="28dp"
        android:shadowColor="#66000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="2"
        android:textColor="@color/text_primary"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
