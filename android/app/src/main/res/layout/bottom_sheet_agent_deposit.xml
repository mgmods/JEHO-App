<?xml version="1.0" encoding="utf-8"?>
<!-- Agent USDT deposit sheet: hourglass + address + copy + "I paid" -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_aura_dialog_surface"
        android:orientation="vertical"
        android:padding="18dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_sheet_handle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="تفاصيل الدفع"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAgentDepositNetwork"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="TRX · TRC20"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <ProgressBar
                android:id="@+id/progressRing"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:max="100"
                android:progressDrawable="@drawable/bg_deposit_ring" />

            <TextView
                android:id="@+id/tvHourglass"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="⏳"
                android:textSize="28sp" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvAgentDepositAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="0 USDT"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAgentDepositCoins"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="—"
            android:textColor="@color/text_hint"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="عنوان الإيداع"
            android:textColor="@color/text_hint"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvAgentDepositAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_list_card"
            android:fontFamily="monospace"
            android:gravity="center"
            android:padding="14dp"
            android:textColor="@color/text_secondary"
            android:textIsSelectable="true"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/agentTagRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Memo / Tag"
                android:textColor="@color/text_hint"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvAgentDepositTag"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_list_card"
                android:fontFamily="monospace"
                android:gravity="center"
                android:padding="12dp"
                android:textColor="@color/aurora_gold"
                android:textIsSelectable="true"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAgentCopyAddress"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="نسخ العنوان"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                app:cornerRadius="14dp"
                app:strokeColor="@color/aurora_cyan" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAgentCopyAmount"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="نسخ المبلغ"
                android:textAllCaps="false"
                android:textColor="@color/aurora_gold"
                app:cornerRadius="14dp"
                app:strokeColor="@color/aurora_gold" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAgentCopyTag"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="نسخ Memo/Tag"
            android:textAllCaps="false"
            android:textColor="@color/text_secondary"
            android:visibility="gone"
            app:cornerRadius="14dp"
            app:strokeColor="@color/aurora_mint" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAgentPaid"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp"
            android:enabled="false"
            android:text="بانتظار تأكيد الشبكة…"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="#445566"
            app:cornerRadius="16dp" />

        <TextView
            android:id="@+id/tvAgentDepositStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="أرسل المبلغ بالضبط — الكشف تلقائي فوري بدون زر «لقد دفعت»"
            android:textColor="@color/text_hint"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
