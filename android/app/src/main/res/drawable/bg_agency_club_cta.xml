<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle"><solid android:color="#FF51515B" /><corners android:radius="14dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><gradient android:angle="0" android:startColor="#FFB77B38" android:endColor="#FF8D5A2B" /><corners android:radius="14dp" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><gradient android:angle="0" android:startColor="#FF9B75E8" android:endColor="#FF6846B7" /><corners android:radius="14dp" /><stroke android:width="1dp" android:color="#88D5C3FF" /></shape>
    </item>
</selector>