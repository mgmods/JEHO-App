<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:endColor="#37104F"
                android:startColor="#B32375" />
            <corners android:radius="22dp" />
            <stroke
                android:width="1dp"
                android:color="#88FFD36A" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00101D2D"
                android:startColor="#44FFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</layer-list>
