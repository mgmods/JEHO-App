<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient android:angle="315" android:startColor="#FFFFD7E8" android:centerColor="#FFFF72B0" android:endColor="#FFE52C79" />
            <stroke android:width="1.5dp" android:color="#FFFFF2F8" />
        </shape>
    </item>
    <item android:left="4dp" android:top="3dp" android:right="4dp" android:bottom="5dp">
        <shape android:shape="oval">
            <gradient android:angle="270" android:startColor="#88FFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
