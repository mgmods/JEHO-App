<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Soft drop for logo disk on white auth plane -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#14000000" />
        </shape>
    </item>
    <item
        android:bottom="3dp"
        android:left="1dp"
        android:right="1dp"
        android:top="0dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
            <stroke
                android:width="1.5dp"
                android:color="#22FE2C55" />
        </shape>
    </item>
</layer-list>
