<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ProfileLuxuryShortcut">
        <item name="android:layout_width">0dp</item><item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">3dp</item><item name="android:background">@drawable/bg_profile_lux_card</item>
        <item name="android:clickable">true</item><item name="android:focusable">true</item>
    </style>
    <style name="ProfileLuxuryEmoji">
        <item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">22sp</item>
    </style>
    <style name="ProfileLuxuryLabel">
        <item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">5dp</item><item name="android:textColor">#5D482B</item>
        <item name="android:textSize">11sp</item><item name="android:gravity">center</item>
    </style>
    <style name="ProfileLuxuryMenuRow">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">48dp</item>
        <item name="android:gravity">center_vertical</item><item name="android:clickable">true</item><item name="android:focusable">true</item>
    </style>
    <style name="ProfileLuxuryMenuLabel">
        <item name="android:layout_width">0dp</item><item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item><item name="android:layout_marginHorizontal">10dp</item>
        <item name="android:textColor">#49371D</item><item name="android:textSize">13sp</item>
    </style>
    <style name="ProfileLuxuryArrow">
        <item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#A17A39</item><item name="android:textSize">26sp</item>
    </style>
    <style name="ProfileLuxuryDivider">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">1dp</item>
        <item name="android:background">#E9DCC5</item>
    </style>
</resources>