{
  "name": "auralive-backend",
  "version": "1.0.0",
  "description": "AuraLive live streaming platform API",
  "author": "AuraLive",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "seed": "ts-node -r tsconfig-paths/register src/database/seed.ts",
    "migrate:room-systems": "node scripts/migrate-professional-room-systems.js",
    "migrate:professional-room-features": "node scripts/migrate-professional-room-features.js",
    "migrate:payments": "node scripts/migrate-payments-agents-theme.js",
    "migrate:dashboard-assets": "node scripts/migrate-dashboard-assets.js",
    "seed:catalog": "node scripts/upsert_catalog_pack.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "migrate:cp-system": "node scripts/migrate-cp-system.js",
    "test:games": "node --test -r ts-node/register src/modules/games/mikoo-gateway/mikoo-house-edge.util.spec.ts src/modules/games/casual-bet-idempotency.util.spec.ts",
    "test:cp-bootstrap": "node scripts/test-cp-bootstrap-postgres.js",
    "test:auth-room": "node --test -r ts-node/register src/modules/auth/auth-room-regression.spec.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.11",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.11",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.2.11",
    "@nestjs/platform-socket.io": "11.2.11",
    "@nestjs/swagger": "11.4.8",
    "@nestjs/throttler": "^6.3.0",
    "@nestjs/typeorm": "11.0.3",
    "@nestjs/websockets": "11.2.11",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/ws": "^8.18.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "firebase-admin": "13.10.0",
    "google-auth-library": "^9.15.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jpeg-js": "^0.4.4",
    "livekit-server-sdk": "^2.17.0",
    "multer": "2.5.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.1",
    "pngjs": "^7.0.0",
    "protobufjs": "^8.7.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "stripe": "^17.5.0",
    "typeorm": "^0.3.20",
    "uuid": "^11.1.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/uuid": "^10.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "multer": "2.5.0",
    "body-parser": "1.20.9",
    "js-yaml": "4.3.2",
    "lodash": "4.18.1",
    "glob": "14.0.2",
    "picomatch": "4.0.7",
    "tmp": "0.2.7",
    "qs": "6.17.1",
    "webpack": "5.105.0",
    "@angular-devkit/core": {
      "ajv": "8.18.0"
    },
    "minimatch": "11.0.1",
    "uuid": "$uuid"
  }
