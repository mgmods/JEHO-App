NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=auralive
DB_PASSWORD=auralive_secret
DB_DATABASE=auralive
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=change-me-jwt-secret-min-32-chars-long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# ZEGOCLOUD — fill from console (never commit real secrets)
ZEGO_APP_ID=0
ZEGO_APP_SIGN=
ZEGO_SERVER_SECRET=
ZEGO_CALLBACK_SECRET=
ZEGO_TOKEN_TTL=3600
ZEGO_WS_URL=
ZEGO_WS_URL_BAK=

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Uploads
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE_MB=20

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Fourthwall (card checkout via hosted shop — never commit real secrets)
FOURTHWALL_API_USER=
FOURTHWALL_API_PASSWORD=
FOURTHWALL_STOREFRONT_TOKEN=
FOURTHWALL_WEBHOOK_SECRET=
FOURTHWALL_SHOP_DOMAIN=your-shop.fourthwall.com
# Map each wallet package SKU → Fourthwall variant UUID
FOURTHWALL_VARIANT_MAP={"coins_1000":"variant-uuid-here"}

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# Google Play Billing
GOOGLE_PLAY_PACKAGE_NAME=com.Dramizo.Series
# Path to a Google Play Console service-account JSON with Android Publisher access
GOOGLE_APPLICATION_CREDENTIALS=/secure/path/google-play-service-account.json
# Force Google API verify even outside production (recommended once credentials exist)
GOOGLE_PLAY_VERIFY_ENFORCE=false

# FCM
FCM_SERVER_KEY=

# Admin seed
ADMIN_EMAIL=admin@auralive.com
ADMIN_PASSWORD=Admin@AuraLive2024
ADMIN_USERNAME=auralive_admin

# Throttle
THROTTLE_TTL=60
THROTTLE_LIMIT=100
