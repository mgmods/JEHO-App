{
  "name": "lyvo-cloud",
  "version": "1.0.0",
  "private": true,
  "description": "LYVO Cloud — standalone RTC developer console (separate from JEHO CHAT API)",
  "scripts": {
    "dev:server": "node --watch server/index.mjs",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "start": "node server/index.mjs",
    "install:all": "npm install && npm --prefix web install"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^5.1.0",
    "stripe": "^17.5.0"
  }
}
