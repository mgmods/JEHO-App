# LYVO Cloud — standalone site (NOT JEHO /api backend)
# Domain: cloud.adastra.bbs.tr  |  LiveKit media stays on voice.adastra.bbs.tr

PORT=3910
HOST=0.0.0.0
JWT_SECRET=change-me-lyvo-cloud-long-secret
PUBLIC_URL=https://cloud.adastra.bbs.tr
DATA_DIR=./data

# ── Card payments: Fourthwall (same service as JEHO Android app) ──
# Paste the same values from app admin: Settings → Payment → Fourthwall
# Or set them in LYVO Seller → Fourthwall (stored in data/lyvo-db.json)
FOURTHWALL_API_USER=
FOURTHWALL_API_PASSWORD=
FOURTHWALL_STOREFRONT_TOKEN=
FOURTHWALL_SHOP_DOMAIN=
FOURTHWALL_WEBHOOK_SECRET=
# Webhook URL to register in fourthwall.com:
# https://cloud.adastra.bbs.tr/api/billing/fourthwall/webhook

# Optional secondary (USD wallet only) — not required for minutes packs
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: LiveKit tokens for console demos
LIVEKIT_URL=wss://voice.adastra.bbs.tr
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

BOOTSTRAP_EMAIL=owner@lyvo.cloud
BOOTSTRAP_PASSWORD=ChangeMeNow!
BOOTSTRAP_NAME=LYVO Owner
