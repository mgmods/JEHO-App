# Copy to .env before starting Docker Compose.
# Keep real secrets out of Git.

DB_USERNAME=auralive
DB_PASSWORD=change-this-password
DB_DATABASE=auralive
API_PORT=3000

# Backend application secrets
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret

# ZEGOCLOUD
ZEGO_APP_ID=0
ZEGO_APP_SIGN=
ZEGO_SERVER_SECRET=
ZEGO_CALLBACK_SECRET=
ZEGO_TOKEN_TTL=3600
ZEGO_WS_URL=
ZEGO_WS_URL_BAK=

# Public API origin used by invite/game routes
PUBLIC_API_ORIGIN=http://localhost:3000
